<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.PrincipalController">

    <top>
        <VBox>
            <HBox styleClass="barra-superior">
                <VBox spacing="2">
                    <Label text="Gestión de inventario" styleClass="titulo-app"/>
                    <Label text="Panel de control de productos" styleClass="subtitulo-app"/>
                </VBox>
            </HBox>

            <HBox spacing="16" style="-fx-padding: 20 25 10 25;">

                <HBox styleClass="tarjeta-kpi, kpi-azul" spacing="14" alignment="CENTER_LEFT">
                    <Label text="📦" styleClass="kpi-icono"/>
                    <VBox spacing="2">
                        <Label text="TOTAL PRODUCTOS" styleClass="kpi-etiqueta"/>
                        <Label fx:id="labelTotalProductos" text="0" styleClass="kpi-valor"/>
                    </VBox>
                </HBox>

                <HBox styleClass="tarjeta-kpi, kpi-verde" spacing="14" alignment="CENTER_LEFT">
                    <Label text="💶" styleClass="kpi-icono"/>
                    <VBox spacing="2">
                        <Label text="VALOR DEL INVENTARIO" styleClass="kpi-etiqueta"/>
                        <Label fx:id="labelValorInventario" text="0,00 €" styleClass="kpi-valor"/>
                    </VBox>
                </HBox>

                <HBox styleClass="tarjeta-kpi, kpi-naranja" spacing="14" alignment="CENTER_LEFT">
                    <Label text="⚠" styleClass="kpi-icono"/>
                    <VBox spacing="2">
                        <Label text="STOCK BAJO (&lt;5)" styleClass="kpi-etiqueta"/>
                        <Label fx:id="labelStockBajo" text="0" styleClass="kpi-valor"/>
                    </VBox>
                </HBox>

            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 10 25 10 25;">
            <TableView fx:id="tablaProductos">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="120"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="12" styleClass="panel-formulario" style="-fx-margin: 0 25 20 25;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Añadir / editar producto" styleClass="panel-titulo"/>

            <HBox spacing="10">
                <TextField fx:id="campoNombre" promptText="Nombre"/>
                <TextField fx:id="campoPrecio" promptText="Precio"/>
                <TextField fx:id="campoStock" promptText="Stock"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="botonAgregar" text="Agregar" onAction="#onAgregar" styleClass="boton-agregar"/>
                <Button fx:id="botonEditar" text="Editar" onAction="#onEditar" styleClass="boton-editar"/>
                <Button fx:id="botonEliminar" text="Eliminar" onAction="#onEliminar" styleClass="boton-eliminar"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>